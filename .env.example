# 2GIS Catalog API key (получить на https://platform.2gis.ru / dev.2gis.ru)
TWOGIS_API_KEY=

# Опционально: путь к БД (по умолчанию ~/.neo_parser/neo_parser.sqlite3)
# NEO_PARSER_DB=

# Таймаут HTTP-запросов к сайтам (секунды)
AUDIT_TIMEOUT=10

# Максимум страниц результатов 2ГИС за один поиск
TWOGIS_MAX_PAGES=5
